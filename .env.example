# .env.example — Self-Hosted Workspace MVP
# ============================================
# Copy this file to .env and fill in real values.
# Secrets are NEVER committed or embedded in Docker images.
# Dokploy injects these at deploy time from its environment UI.
#
# Usage:
#   cp .env.example .env   # local development
#   → Dokploy env UI        # production deployment


# ── AI Provider Keys ──────────────────────────────────────────────────────
# Used by opencode-server and CodeNomad for AI completions.
ANTHROPIC_API_KEY=<your-anthropic-api-key>
OPENAI_API_KEY=<your-openai-api-key>


# ── Service Authentication ────────────────────────────────────────────────
# Each public-facing service has its own auth layer behind Cloudflare Access.
CODE_SERVER_PASSWORD=<your-code-server-password>
OPENCODE_SERVER_USERNAME=<your-opencode-server-username>
OPENCODE_SERVER_PASSWORD=<your-opencode-server-password>
CODENOMAD_SERVER_USERNAME=<your-codenomad-username>
CODENOMAD_SERVER_PASSWORD=<your-codenomad-password>
KASMVNC_PASSWORD=<your-kasmvnc-password>
